# Nunca subas tu clave real a GitHub.
RIOT_API_KEY=RGAPI-PEGA_AQUI_TU_CLAVE

# Los cinco participantes juegan en LAN.
RIOT_PLATFORM=la1
RIOT_REGION=americas

# Reto: todo agosto de 2026, horario de Ecuador continental.
CHALLENGE_YEAR=2026
CHALLENGE_MONTH=8
CHALLENGE_TIMEZONE=America/Guayaquil

# La web consulta datos nuevos como máximo una vez cada 5 minutos.
CACHE_SECONDS=300

# Partidas SoloQ recientes usadas para el análisis de cada jugador en vivo (3-10).
LIVE_RECENT_MATCHES=5
